---
import Layout from '../layouts/Layout.astro'
import Hero from '../components/Hero.astro'
import Services from '../components/Services.astro'
import ProcessSteps from '../components/ProcessSteps.astro'
import TrustBand from '../components/TrustBand.astro'
import FAQ from '../components/FAQ.astro'
import ContactCTA from '../components/ContactCTA.astro'
import ConsultationDialog from '../components/ConsultationDialog.astro'
import EbotFab from '../components/EbotFab.astro'
import Navigation from '../components/Navigation.astro'
import JsonLd from '../components/JsonLd.astro'
import { t, getLocaleFromRequest, getDir } from '../i18n'
import { ArrowRight } from 'lucide-astro'

const locale = Astro.locals.locale ?? 'id'
const dir = getDir(locale)

const FAQ_COUNT = 8
const faqItems = []
for (let i = 0; i < FAQ_COUNT; i++) {
  const question = t(`faq.items[${i}].question`, locale)
  const answer = t(`faq.items[${i}].answer`, locale)
  if (question && !question.includes('faq.items[')) {
    faqItems.push({ question, answer })
  }
}

---

<Layout
  title="Ekalliptus Digital | Jasa Website & Aplikasi Mobile Indonesia"
  description="Pengembangan website, aplikasi mobile, serta maintenance website dan server untuk bisnis di Indonesia."
  lang={locale}
  dir={dir}
>
  <JsonLd locale={locale} faqItems={faqItems} />
  <Navigation t={(key: string) => t(key, locale)} currentLang={locale} />

  <main id="main-content" class="relative z-0 flex min-h-screen flex-col pt-14 sm:pt-16 md:pt-20">
    <Hero t={(key: string) => t(key, locale)} />
    <Services t={(key: string) => t(key, locale)} />
    <ProcessSteps t={(key: string) => t(key, locale)} />
    <TrustBand t={(key: string) => t(key, locale)} />
    <FAQ t={(key: string) => t(key, locale)} />
    <ContactCTA t={(key: string) => t(key, locale)} />
    <ConsultationDialog t={(key: string) => t(key, locale)} />
    <EbotFab />

    <!-- Blog teaser -->
    <section id="blog" class="content-vis px-4 py-16 sm:py-20">
      <div class="mx-auto max-w-6xl">
        <div class="mb-8 flex flex-col items-start justify-between gap-4 sm:mb-12 sm:flex-row sm:items-end">
          <div>
            <span class="text-xs font-semibold uppercase tracking-[0.35em] text-primary">{t('blog.badge', locale)}</span>
            <h2 class="mt-3 text-2xl font-bold text-foreground sm:text-3xl md:text-4xl">{t('blog.title', locale)}</h2>
            <p class="mt-2 max-w-2xl text-base text-muted-foreground">{t('blog.description', locale)}</p>
          </div>
          <a
            href="/id/blog"
            class="hidden flex-shrink-0 items-center gap-2 rounded-full border border-border/40 bg-card/20 px-5 py-2.5 text-sm font-semibold text-foreground/80 transition hover:bg-card/30 sm:inline-flex cursor-interactive"
          >
            {t('blog.readMore', locale)}
            <ArrowRight class="h-4 w-4" />
          </a>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          <a href="/id/blog/jasa-pembuatan-website-tegal" class="group glass-card overflow-hidden rounded-3xl transition-all hover:-translate-y-1 hover:shadow-lg hover:shadow-primary/5 cursor-interactive">
            <div class="skel-shimmer aspect-video overflow-hidden bg-card/30">
              <img src="/blog/jasa-website-tegal.svg" alt="Jasa Pembuatan Website Tegal" width="640" height="360" class="img-skel h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy" decoding="async" onload="this.classList.add('img-loaded')" onerror="this.onerror=null;this.src='/blog/placeholder.svg'" />
            </div>
            <div class="p-5 sm:p-6">
              <span class="rounded-full bg-primary/10 px-3 py-1 text-[0.65rem] font-semibold uppercase tracking-wider text-primary">{t('blog.categories.web-development', locale)}</span>
              <h3 class="mt-3 text-lg font-semibold text-foreground transition-colors group-hover:text-primary">Jasa Pembuatan Website di Tegal</h3>
              <p class="mt-2 line-clamp-2 text-sm text-muted-foreground">Panduan memilih layanan pembuatan website untuk bisnis di Tegal dan Indonesia.</p>
            </div>
          </a>

          <a href="/id/blog/biaya-pembuatan-aplikasi-android-ios" class="group glass-card overflow-hidden rounded-3xl transition-all hover:-translate-y-1 hover:shadow-lg hover:shadow-primary/5 cursor-interactive">
            <div class="skel-shimmer aspect-video overflow-hidden bg-card/30">
              <img src="/blog/biaya-aplikasi-mobile.svg" alt="Biaya Pembuatan Aplikasi Mobile" width="640" height="360" class="img-skel h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy" decoding="async" onload="this.classList.add('img-loaded')" onerror="this.onerror=null;this.src='/blog/placeholder.svg'" />
            </div>
            <div class="p-5 sm:p-6">
              <span class="rounded-full bg-accent/10 px-3 py-1 text-[0.65rem] font-semibold uppercase tracking-wider text-accent">{t('blog.categories.mobile-app', locale)}</span>
              <h3 class="mt-3 text-lg font-semibold text-foreground transition-colors group-hover:text-primary">Biaya Pembuatan Aplikasi Android & iOS di Indonesia</h3>
              <p class="mt-2 line-clamp-2 text-sm text-muted-foreground">Panduan lengkap estimasi biaya pembuatan aplikasi mobile cross-platform dengan React Native dan Flutter.</p>
            </div>
          </a>
        </div>

        <div class="mt-8 text-center sm:hidden">
          <a href="/id/blog" class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground transition hover:bg-primary/90">
            {t('blog.readMore', locale)}
            <ArrowRight class="h-4 w-4" />
          </a>
        </div>
      </div>
    </section>


  </main>
</Layout>
