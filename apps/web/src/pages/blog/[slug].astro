---
import Layout from '../../layouts/Layout.astro'
import '../../styles/prose.css'
import { fetchPostBySlug, fetchPublishedPostSummaries, normalizeBlogImage } from '../../lib/supabase'
import { blogPath, relatedPosts, tagPath } from '../../lib/blog'
import { getLocaleFromRequest, getDir } from '../../i18n'
import Navigation from '../../components/Navigation.astro'
import SocialShare from '../../components/SocialShare.astro'
import AdUnit from '../../components/AdUnit.astro'
import { waLink } from '../../lib/constants'
import { Calendar, User, Tag, ArrowLeft, Clock, List } from 'lucide-astro'
import { t } from '../../i18n'
import { resolveAuthor } from '../../data/authors'
import { sanitizeArticleHtml, serializeJsonLd } from '../../lib/article-html'

export const prerender = false

const locale = Astro.locals.locale ?? 'id'
const dir = getDir(locale)
const postResult = await fetchPostBySlug(Astro.params.slug as string, 'id')
if (postResult.status === 'not_found') return new Response('Not found', { status: 404 })
if (postResult.status === 'error') return new Response('Blog temporarily unavailable', { status: 503 })
const postData = postResult.data

const post = {
  id: postData.slug,
  slug: postData.slug,
  locale: postData.locale,
  data: {
    title: postData.title,
    description: postData.description,
    publishDate: new Date(postData.publish_date),
    updateDate: postData.update_date ? new Date(postData.update_date) : null,
    category: postData.category,
    tags: postData.tags ?? [],
    author: postData.author,
    image: normalizeBlogImage(postData.image),
    imageAlt: postData.image_alt,
    featured: postData.featured ?? false,
    seo: {
      metaTitle: postData.seo_meta_title ?? null,
      metaDescription: postData.seo_meta_description ?? null,
      noindex: postData.seo_noindex ?? null
    }
  },
  body_html: sanitizeArticleHtml(postData.body_html)
}

const siteUrl = 'https://ekalliptus.com'
const canonical = new URL(Astro.locals.publicPathname ?? Astro.url.pathname, siteUrl).toString()

const metaTitle = post.data.seo?.metaTitle || post.data.title
const metaDescription = post.data.seo?.metaDescription || post.data.description
// SVG images don't work as og:image. Fallback to /og-image.webp for SVGs.
const ogImage = post.data.image && !post.data.image.endsWith('.svg')
  ? post.data.image
  : '/og-image.webp'
const ogImageAlt = post.data.imageAlt || post.data.title

const author = resolveAuthor(post.data.author)
const schemaImage = new URL(ogImage, siteUrl).toString()

// JSON-LD structured data
const blogPostSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  image: schemaImage,
  url: canonical,
  datePublished: post.data.publishDate.toISOString(),
  dateModified: (post.data.updateDate || post.data.publishDate).toISOString(),
  author: { '@type': 'Organization', '@id': author.id, name: author.name, url: author.url },
  publisher: { '@type': 'Organization', '@id': author.id, name: author.name, url: author.url },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  inLanguage: locale,
  wordCount: (post.body_html || '').replace(/<[^>]*>/g, '').trim().split(/\s+/).length,
  articleSection: post.data.category,
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/id` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteUrl}/id/blog` },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: canonical }
  ]
}

const headingIdRe = /<(h[2-4])([^>]*)>([\s\S]*?)<\/\1>/gi
// Keep unicode word characters so non-Latin headings (Cyrillic, CJK, Arabic,
// Thai, ...) still produce readable ids; fall back to h-<index> when nothing
// survives so the id is never empty. Index counts generated ids only, which
// keeps fallbacks unique and stable per page.
let generatedHeadingCount = 0
const processedHtml = (post.body_html || '').replace(headingIdRe, (match, tag, attrs, inner) => {
  if (/\bid\s*=/.test(attrs)) return match
  const text = inner.replace(/<[^>]*>/g, '').trim()
  const slug = text.toLowerCase().replace(/[^a-z0-9\u00C0-\u024F\u0370-\u1FFF\u3040-\uD7FF\s-]/gi, '').replace(/\s+/g, '-').replace(/(^-|-$)/g, '')
  generatedHeadingCount += 1
  const id = slug || `h-${generatedHeadingCount}`
  return `<${tag}${attrs} id="${id}">${inner}</${tag}>`
})

// Wrap tables in a scroll container so wide comparison tables stay usable on mobile.
const tableWrappedHtml = processedHtml.replace(/<table[\s\S]*?<\/table>/g, (m) => `<div class="table-wrap">${m}</div>`)

const relatedResult = await fetchPublishedPostSummaries('id', 6)
const related = relatedResult.status === 'ok' ? relatedPosts(postData, relatedResult.data) : []

const processedTocHeadings: Array<{ depth: number; slug: string; text: string }> = []
const tocRe = /<(h[2-4])\s[^>]*id="([^"]+)"[^>]*>([\s\S]*?)<\/\1>/gi
let tocMatch: RegExpExecArray | null
while ((tocMatch = tocRe.exec(processedHtml)) !== null) {
  const text = tocMatch[3]
    .replace(/<[^>]*>/g, '')
    .replace(/&#(\d+);/g, (_, n) => Number(n) <= 0x10ffff ? String.fromCodePoint(Number(n)) : '�')
    .replace(/&#x([0-9a-f]+);/gi, (_, n) => parseInt(n, 16) <= 0x10ffff ? String.fromCodePoint(parseInt(n, 16)) : '�')
    .replace(/&nbsp;/g, ' ')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&apos;/g, "'")
    .replace(/&amp;/g, '&')
    .replace(/\s+/g, ' ')
    .trim()
  processedTocHeadings.push({ depth: Number(tocMatch[1].slice(1)), slug: tocMatch[2], text })
}
---
<Layout
  title={metaTitle}
  description={metaDescription}
  lang={locale}
  dir={dir}
  noindex={post.data.seo?.noindex ?? false}
  image={ogImage}
  imageAlt={ogImageAlt}
  type="article"
  publishedTime={post.data.publishDate.toISOString()}
  modifiedTime={(post.data.updateDate || post.data.publishDate).toISOString()}
  author={author.name}
  adsense
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={serializeJsonLd(blogPostSchema)}></script>
    <script type="application/ld+json" set:html={serializeJsonLd(breadcrumbSchema)}></script>
  </Fragment>
  <div id="reading-progress-bar" class="fixed top-0 left-0 h-1 bg-primary z-[100] transition-all duration-150" style="width:0%"></div>
  <Navigation t={(key: string) => t(key, locale)} currentLang={locale} />

  <main id="main-content" class="article-page container mx-auto px-4 pt-24 pb-6">
    <!-- Article Header -->
    <section class="article-header px-4 py-6 sm:py-8 md:py-10">
      <div class="mx-auto max-w-5xl">
        <!-- Breadcrumb -->
        <nav class="text-sm mb-3" aria-label="Breadcrumb">
          <a href="/" class="text-muted-foreground hover:text-foreground">Home</a>
          <span class="mx-2 text-muted-foreground">/</span>
          <a href="/id/blog" class="text-muted-foreground hover:text-foreground">Blog</a>
          <span class="mx-2 text-muted-foreground">/</span>
          <span aria-current="page" class="text-foreground">{post.data.title}</span>
        </nav>

        <!-- Badges -->
        <div class="flex flex-wrap items-center gap-2 mb-4">
          {post.data.category && (
            <span class="glass-pill rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-wider text-primary border-primary/30">{post.data.category}</span>
          )}
          {processedTocHeadings.length > 0 && (
            <span class="glass-pill rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-wider text-accent border-accent/30">TOC</span>
          )}
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-foreground mb-4">{post.data.title}</h1>
        {post.data.description && (
          <p class="article-intro text-base sm:text-lg text-muted-foreground mb-6">{post.data.description}</p>
        )}

        <!-- Meta info card -->
        <div class="article-meta p-4 mb-6">
          <div class="flex items-center gap-4 text-xs text-muted-foreground">
            <div class="flex items-center gap-2">
              <User class="h-4 w-4" />
              <a href={author.url}>{author.name}</a>
            </div>
            <span aria-hidden="true">•</span>
            <div class="flex items-center gap-2">
              <Calendar class="h-4 w-4" />
              <time datetime={post.data.publishDate.toISOString()}>
                {post.data.publishDate.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}
              </time>
            </div>
            {post.data.updateDate && (
              <>
                <span aria-hidden="true">•</span>
                <div class="flex items-center gap-2">
                  <Calendar class="h-4 w-4" />
                  <time datetime={post.data.updateDate.toISOString()}>
                    Updated {post.data.updateDate.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}
                  </time>
                </div>
              </>
            )}
            <span aria-hidden="true">•</span>
            <div class="flex items-center gap-2">
              <Clock class="h-4 w-4" />
              <span>{Math.max(1, Math.ceil((post.body_html || '').replace(/<[^>]*>/g, '').trim().split(/\s+/).length / 200))} menit baca</span>
            </div>
          </div>
        </div>

        <div class="mb-6">
          <img src={post.data.image} alt={post.data.imageAlt || post.data.title} width="1200" height="630" class="aspect-[40/21] w-full rounded-xl object-cover bg-card/30" loading="eager" fetchpriority="high" decoding="async" onerror="this.onerror=null;this.src='/blog/placeholder.svg'" />
        </div>

        {post.data.tags?.length > 0 && (
          <div class="flex flex-wrap gap-2 mb-6">
            {post.data.tags.map((tag: string) => (
              <a href={tagPath(tag)} class="glass-pill rounded-full px-2 py-0.5 text-xs font-semibold uppercase tracking-wider text-muted-foreground border-border/10">#{tag}</a>
            ))}
          </div>
        )}
      </div>
    </section>

    <!-- Ad: after intro -->
    <section class="px-4 pb-6">
      <div class="mx-auto max-w-5xl">
        <AdUnit format="horizontal" className="rounded-xl overflow-hidden" />
      </div>
    </section>

    <!-- Main content with TOC sidebar and article body -->
    <section class="px-4 pb-12">
      <div class="article-layout mx-auto max-w-6xl grid grid-cols-12 gap-8">
        <!-- Desktop TOC + Sidebar Ad -->
        {processedTocHeadings.length > 0 && (
          <aside class="article-sidebar hidden lg:block col-span-3">
            <div class="sticky top-32 space-y-6">
              <div class="glass-panel p-4">
                <nav aria-label="Table of contents"><h2 class="toc-title">Dalam artikel ini</h2>
                  <ul class="space-y-2">
                    {processedTocHeadings.map((h) => (
                      <li>
                        <a href={`#${h.slug}`} class="toc-link">{h.text}</a>
                      </li>
                    ))}
                  </ul>
                </nav>
              </div>
              <AdUnit format="vertical" className="rounded-xl overflow-hidden" />
            </div>
          </aside>
        )}

        <article class="col-span-12 lg:col-span-9 prose prose-lg prose-invert max-w-none" set:html={tableWrappedHtml}></article>
      </div>
    </section>

    <!-- Ad: after article -->
    <section class="px-4 pb-6">
      <div class="mx-auto max-w-5xl">
        <AdUnit format="auto" className="rounded-xl overflow-hidden" />
      </div>
    </section>

    <!-- Share section -->
    <section class="px-4 pb-6">
      <SocialShare title={post.data.title} url={canonical} description={post.data.description} image={post.data.image ?? undefined} showLabels={true} />
    </section>

    <!-- Author box -->
    <section class="px-4 pb-6">
      <div class="glass-panel p-6">
        <div class="flex items-center gap-3">
          <div class="h-12 w-12 rounded-full bg-card/30 flex items-center justify-center">A</div>
          <div>
            <a href="/about" class="font-semibold hover:text-primary">{author.name}</a>
            <div class="text-xs text-muted-foreground">Tim editorial</div>
          </div>
        </div>
        <p class="mt-3 text-sm text-muted-foreground">{author.bio}</p>
        <a href="/editorial-policy" class="mt-2 inline-block text-sm font-semibold text-primary hover:text-primary/80">Kebijakan editorial</a>
      </div>
    </section>

    {related.length > 0 && (
      <section class="px-4 pb-8">
        <div class="mx-auto max-w-5xl">
          <h2 class="mb-4 text-2xl font-bold">Artikel terkait</h2>
          <ul class="grid gap-3 sm:grid-cols-3">
            {related.map(item => <li><a class="text-primary hover:underline" href={blogPath(item.slug)}>{item.title}</a></li>)}
          </ul>
        </div>
      </section>
    )}

    <!-- Back to blog CTA -->
    <section class="px-4 pb-12">
      <a href="/id/blog" class="text-sm font-semibold text-primary hover:text-primary/80">← {t('blog.backToBlog', locale) || 'Back to Blog'}</a>
    </section>

    {processedTocHeadings.length > 0 && <details class="mobile-toc lg:hidden">
      <summary><List size={18} aria-hidden="true" /> Dalam artikel ini</summary>
      <nav aria-label="Daftar isi">{processedTocHeadings.map(h => <a href={`#${h.slug}`} class="toc-link">{h.text}</a>)}</nav>
    </details>}

    <!-- Floating WhatsApp CTA -->
    <div id="wa-floating" class="fixed bottom-6 right-6 z-50 flex flex-col items-end gap-2">
      <a href={waLink('Halo Ekalliptus, saya baru membaca artikel di blog dan ingin konsultasi lebih lanjut.')} target="_blank" rel="noopener noreferrer" class="rounded-full bg-green-500 hover:bg-green-600 text-white p-3.5 shadow-lg transition-all hover:scale-110" aria-label="Chat via WhatsApp">
        <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
      </a>
    </div>

    <!-- Client-side script -->
    <script is:inline>
      const progressBar = document.getElementById('reading-progress-bar')
      const onScroll = () => {
        const max = document.documentElement.scrollHeight - window.innerHeight
        const px = Math.max(0, Math.min(100, (window.scrollY / Math.max(1, max)) * 100))
        if (progressBar) progressBar.style.width = px + '%'
      }
      window.addEventListener('scroll', onScroll, { passive: true })
      onScroll()

      const tocLinks = document.querySelectorAll('.toc-link')
      tocLinks.forEach(link => link.addEventListener('click', () => document.querySelector('.mobile-toc')?.removeAttribute('open')))

      // Scroll-spy: highlight the TOC entry for the section currently in view.
      if (tocLinks.length > 0 && 'IntersectionObserver' in window) {
        const headingEls = Array.from(document.querySelectorAll('.prose h2[id], .prose h3[id], .prose h4[id]'))
        const linkForId = new Map()
        tocLinks.forEach(l => {
          const id = l.getAttribute('href')?.slice(1)
          if (id) linkForId.set(id, l)
        })
        let activeId = null
        const spy = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              activeId = entry.target.id
            }
          }
          tocLinks.forEach(l => l.classList.toggle('toc-active', l.getAttribute('href') === `#${activeId}`))
        }, { rootMargin: '-15% 0px -70% 0px' })
        headingEls.forEach(h => spy.observe(h))
      }

      // GA4 Blog Scroll Depth Tracking
      var _scrollMilestone = 0;
      var _scrollThresholds = [25, 50, 75, 90];
      window.addEventListener('scroll', function() {
        var max = document.documentElement.scrollHeight - window.innerHeight;
        if (max <= 0) return;
        var pct = (window.scrollY / Math.max(1, max)) * 100;
        for (var i = 0; i < _scrollThresholds.length; i++) {
          var threshold = _scrollThresholds[i];
          if (pct >= threshold && _scrollMilestone < threshold) {
            _scrollMilestone = threshold;
            if (typeof window.gtag === 'function') {
              window.gtag('event', 'blog_scroll', { percent: threshold, slug: window.location.pathname });
            }
          }
        }
      }, { passive: true });

      // Initialize AdSense units
      document.querySelectorAll('.adsbygoogle').forEach(() => {
        try { (adsbygoogle = window.adsbygoogle || []).push({}) } catch(e) {}
      })
    </script>
  </main>
  
</Layout>
