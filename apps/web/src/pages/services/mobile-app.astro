---
import Layout from '../../layouts/Layout.astro'
import Navigation from '../../components/Navigation.astro'
import ConsultationDialog from '../../components/ConsultationDialog.astro'
import { t, getLocaleFromRequest, getDir } from '../../i18n'
import { waLink } from '../../lib/constants'
import { Check, ArrowRight, Smartphone, Globe, Zap, Shield } from 'lucide-astro'

export const prerender = false

const locale = Astro.locals.locale ?? 'id'
const dir = getDir(locale)

const siteUrl = 'https://ekalliptus.com'
const canonical = new URL(Astro.locals.publicPathname ?? Astro.url.pathname, siteUrl).toString()

const faqs = [
  { question: 'Bagaimana biaya pembuatan aplikasi ditentukan?', answer: 'Biaya ditentukan berdasarkan ruang lingkup, platform, fitur, integrasi, dan kebutuhan backend.' },
  { question: 'React Native atau Flutter, mana yang lebih baik?', answer: 'Keduanya bagus. React Native cocok untuk ekosistem JavaScript, Flutter untuk performa mendekati native. Kami rekomendasikan sesuai kebutuhan project.' },
  { question: 'Apakah aplikasi bisa dipublikasikan ke Play Store dan App Store?', answer: 'Ya, bantuan proses publikasi dan tanggung jawab akun developer dibahas dalam proposal.' },
  { question: 'Berapa lama proses development?', answer: 'Jadwal bergantung pada ruang lingkup, fitur, integrasi, pengujian, dan proses peninjauan platform.' },
  { question: 'Apakah include backend API?', answer: 'Ya, kami develop backend API dengan Node.js/Supabase termasuk autentikasi, database, dan REST endpoints.' },
  { question: 'Apakah ada maintenance setelah launch?', answer: 'Ya, ruang lingkup maintenance dapat disepakati terpisah sesuai kebutuhan aplikasi.' }
]

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Jasa Pembuatan Aplikasi Mobile',
  serviceType: 'Mobile App Development',
  description: 'Jasa pembuatan aplikasi mobile cross-platform Android dan iOS dengan React Native dan Flutter di Indonesia.',
  provider: { '@id': `${siteUrl}#organization` },
  areaServed: { '@type': 'Country', name: 'Indonesia' },
  url: canonical
}

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } }))
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Mobile App Development', item: canonical }
  ]
}
---

<Layout
  title="Jasa Pembuatan Aplikasi Mobile Android & iOS Indonesia | React Native, Flutter - Ekalliptus"
  description="Jasa pembuatan aplikasi mobile Android dan iOS dengan React Native dan Flutter, disesuaikan dengan kebutuhan produk dan bisnis."
  lang={locale}
  dir={dir}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <Navigation t={(key: string) => t(key, locale)} currentLang={locale} />

  <main class="relative z-0 flex min-h-screen flex-col pt-14 sm:pt-16 md:pt-20">
    <div class="container mx-auto max-w-6xl px-4 py-8 sm:py-12">

      <nav class="text-sm mb-6" aria-label="Breadcrumb">
        <a href="/" class="text-muted-foreground hover:text-foreground">Home</a>
        <span class="mx-2 text-muted-foreground">/</span>
        <span class="text-foreground">Jasa Pembuatan Aplikasi Mobile</span>
      </nav>

      <header class="mb-12 text-center">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-foreground mb-4">Jasa Pembuatan Aplikasi Mobile Android & iOS</h1>
        <p class="article-intro text-base sm:text-lg text-muted-foreground max-w-3xl mx-auto leading-relaxed">
          <strong>Jasa pembuatan aplikasi mobile</strong> mencakup pengembangan perangkat lunak untuk Android dan iOS. Ekalliptus Digital menggunakan <strong>React Native dan Flutter</strong> untuk membangun aplikasi sesuai kebutuhan bisnis di Indonesia.
        </p>
      </header>

      <section class="mb-12">
        <h2 class="text-2xl sm:text-3xl font-semibold text-foreground mb-6 text-center">Apa yang Anda Dapatkan</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
          <div class="glass-panel rounded-2xl p-5 bg-card/10 border border-border/20">
            <div class="rounded-full bg-primary/10 p-3 w-fit mb-4"><Smartphone class="h-5 w-5 text-primary" /></div>
            <h3 class="text-lg font-semibold text-foreground mb-2">Cross-Platform</h3>
            <p class="text-sm text-muted-foreground">Satu basis kode dapat digunakan untuk Android dan iOS bila sesuai kebutuhan produk.</p>
          </div>
          <div class="glass-panel rounded-2xl p-5 bg-card/10 border border-border/20">
            <div class="rounded-full bg-primary/10 p-3 w-fit mb-4"><Zap class="h-5 w-5 text-primary" /></div>
            <h3 class="text-lg font-semibold text-foreground mb-2">Performa Native</h3>
            <p class="text-sm text-muted-foreground">Flutter & React Native mendekati performa native app.</p>
          </div>
          <div class="glass-panel rounded-2xl p-5 bg-card/10 border border-border/20">
            <div class="rounded-full bg-primary/10 p-3 w-fit mb-4"><Globe class="h-5 w-5 text-primary" /></div>
            <h3 class="text-lg font-semibold text-foreground mb-2">Backend Included</h3>
            <p class="text-sm text-muted-foreground">API backend dengan Node.js/Supabase, autentikasi, dan database.</p>
          </div>
          <div class="glass-panel rounded-2xl p-5 bg-card/10 border border-border/20">
            <div class="rounded-full bg-primary/10 p-3 w-fit mb-4"><Shield class="h-5 w-5 text-primary" /></div>
            <h3 class="text-lg font-semibold text-foreground mb-2">Publishing Support</h3>
            <p class="text-sm text-muted-foreground">Kami bantu proses upload ke Play Store & App Store.</p>
          </div>
        </div>
      </section>

      <section class="mb-12">
        <h2 class="text-2xl sm:text-3xl font-semibold text-foreground mb-6 text-center">Pilihan Layanan Aplikasi Mobile</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="glass-panel rounded-2xl p-6 bg-card/10 border border-border/20">
            <h3 class="text-xl font-bold text-foreground mb-2">MVP</h3>
            <p class="text-sm text-muted-foreground mb-4">Validasi produk dengan fitur inti</p>
            <ul class="space-y-2 text-sm text-muted-foreground">
              <li class="flex gap-2"><Check class="h-4 w-4 text-primary flex-shrink-0" /> Splash, login, basic features</li>
              <li class="flex gap-2"><Check class="h-4 w-4 text-primary flex-shrink-0" /> Push notification</li>
              <li class="flex gap-2"><Check class="h-4 w-4 text-primary flex-shrink-0" /> Android + iOS</li>
              <li class="flex gap-2"><Check class="h-4 w-4 text-primary flex-shrink-0" /> 2-4 minggu</li>
            </ul>
          </div>
          <div class="glass-panel neon-border rounded-2xl p-6 bg-card/10">
            <h3 class="text-xl font-bold text-foreground mb-2">E-Commerce App</h3>
            <p class="text-sm text-muted-foreground mb-4">Katalog, transaksi, dan pengelolaan pesanan</p>
            <ul class="space-y-2 text-sm text-muted-foreground">
              <li class="flex gap-2"><Check class="h-4 w-4 text-primary flex-shrink-0" /> Catalog, cart, checkout</li>
              <li class="flex gap-2"><Check class="h-4 w-4 text-primary flex-shrink-0" /> Payment gateway</li>
              <li class="flex gap-2"><Check class="h-4 w-4 text-primary flex-shrink-0" /> Order tracking</li>
              <li class="flex gap-2"><Check class="h-4 w-4 text-primary flex-shrink-0" /> 1-3 bulan</li>
            </ul>
          </div>
          <div class="glass-panel rounded-2xl p-6 bg-card/10 border border-border/20">
            <h3 class="text-xl font-bold text-foreground mb-2">Enterprise</h3>
            <p class="text-sm text-muted-foreground mb-4">Fitur dan integrasi sesuai kebutuhan organisasi</p>
            <ul class="space-y-2 text-sm text-muted-foreground">
              <li class="flex gap-2"><Check class="h-4 w-4 text-primary flex-shrink-0" /> Custom features & integrasi</li>
              <li class="flex gap-2"><Check class="h-4 w-4 text-primary flex-shrink-0" /> Admin dashboard (web)</li>
              <li class="flex gap-2"><Check class="h-4 w-4 text-primary flex-shrink-0" /> Real-time, AI/ML optional</li>
              <li class="flex gap-2"><Check class="h-4 w-4 text-primary flex-shrink-0" /> 4-12 bulan</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="mb-12">
        <h2 class="text-2xl sm:text-3xl font-semibold text-foreground mb-6 text-center">Teknologi yang Kami Gunakan</h2>
        <div class="glass-panel rounded-2xl p-6 bg-card/10 border border-border/20 text-center">
          <div class="flex flex-wrap gap-2 justify-center">
            {['React Native', 'Flutter', 'Expo', 'Firebase', 'Supabase', 'TypeScript', 'Node.js', 'Redux', 'GraphQL', 'REST API'].map(tech => (
              <span class="rounded-full bg-primary/10 px-4 py-1.5 text-xs font-medium text-primary">{tech}</span>
            ))}
          </div>
        </div>
      </section>

      <section class="mb-12">
        <h2 class="text-2xl sm:text-3xl font-semibold text-foreground mb-6 text-center">Proses Kerja</h2>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
          {[
            { num: 1, title: 'Konsultasi', desc: 'Diskusi requirement, user stories, dan target audience' },
            { num: 2, title: 'UI/UX Design', desc: 'Wireframe dan mockup di Figma dengan revisi gratis' },
            { num: 3, title: 'Development', desc: 'Sprint-based development dengan daily update' },
            { num: 4, title: 'Launch & Publish', desc: 'Testing, deploy, dan publish ke Play Store & App Store' }
          ].map(step => (
            <div class="glass-panel rounded-2xl p-5 bg-card/10 border border-border/20 text-center">
              <div class="rounded-full bg-primary text-primary-foreground w-10 h-10 flex items-center justify-center font-bold mx-auto mb-3">{step.num}</div>
              <h3 class="font-semibold text-foreground mb-2">{step.title}</h3>
              <p class="text-sm text-muted-foreground">{step.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="mb-12">
        <h2 class="text-2xl sm:text-3xl font-semibold text-foreground mb-6 text-center">FAQ</h2>
        <div class="space-y-3">
          {faqs.map(faq => (
            <details class="glass-panel rounded-2xl p-5 bg-card/10 border border-border/20 group">
              <summary class="font-semibold text-foreground cursor-pointer flex items-center justify-between">
                {faq.question}
                <span class="text-primary group-open:rotate-180 transition-transform">▼</span>
              </summary>
              <p class="text-sm text-muted-foreground mt-3">{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="mb-12">
        <h2 class="text-2xl sm:text-3xl font-semibold text-foreground mb-6 text-center">Artikel Terkait</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <a href="/id/blog/biaya-pembuatan-aplikasi-android-ios" class="glass-panel rounded-2xl p-6 bg-card/10 border border-border/20 hover:border-primary/30 transition group">
            <h3 class="font-semibold text-foreground mb-2 group-hover:text-primary transition">Biaya Pembuatan Aplikasi Android & iOS</h3>
            <p class="text-sm text-muted-foreground">Panduan lengkap estimasi biaya pembuatan aplikasi mobile →</p>
          </a>
          <a href="/id/blog/jasa-web-developer-freelance-indonesia" class="glass-panel rounded-2xl p-6 bg-card/10 border border-border/20 hover:border-primary/30 transition group">
            <h3 class="font-semibold text-foreground mb-2 group-hover:text-primary transition">Freelance vs Agency: Mana yang Tepat?</h3>
            <p class="text-sm text-muted-foreground">Panduan memilih web developer yang sesuai kebutuhan →</p>
          </a>
        </div>
      </section>

      <section class="mb-12 text-center">
        <div class="glass-panel neon-border rounded-2xl sm:rounded-3xl p-8 bg-card/5">
          <h2 class="text-2xl sm:text-3xl font-bold text-foreground mb-3">Siap Membangun Aplikasi Mobile Anda?</h2>
          <p class="text-muted-foreground mb-6">Konsultasi GRATIS, dari ide ke Play Store & App Store.</p>
          <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a href="/order" data-track="order" class="inline-flex items-center justify-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground transition hover:bg-primary/90">
              Order Sekarang <ArrowRight class="h-4 w-4" />
            </a>
            <a href={waLink()} target="_blank" rel="noopener" data-track="whatsapp" class="inline-flex items-center justify-center gap-2 rounded-full border border-border px-6 py-3 text-sm font-semibold text-foreground transition hover:bg-card/30">
              WhatsApp Konsultasi
            </a>
          </div>
        </div>
      </section>

    </div>
    <ConsultationDialog t={(key: string) => t(key, locale)} />
  </main>
</Layout>
