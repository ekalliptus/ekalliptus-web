---
import Layout from '../layouts/Layout.astro'
import Navigation from '../components/Navigation.astro'
import { t, getLocaleFromRequest, getDir } from '../i18n'
import { ArrowRight } from 'lucide-astro'

const locale = Astro.locals.locale ?? 'id'
const dir = getDir(locale)
---

<Layout
  title={`${t('order.title', locale)} | Ekalliptus Digital`}
  description={t('order.subtitle', locale)}
  lang={locale}
  dir={dir}
>
  <Navigation t={(key: string) => t(key, locale)} currentLang={locale} />

  <style>
    .service-btn.selected {
      border-color: hsl(var(--primary) / 0.6) !important;
      box-shadow:
        0 8px 32px hsl(var(--glass-shadow)),
        0 0 0 1px hsl(var(--primary) / 0.6),
        0 0 16px hsl(var(--primary) / 0.12),
        inset 0 1px 0 hsl(0 0% 100% / 0.1) !important;
    }
    .step-dot { transition: background-color .3s ease, transform .3s ease; }
    .step-dot.active { background: hsl(var(--primary)); transform: scale(1.15); }

    /* Toast dialog */
    .toast-backdrop {
      position: fixed; inset: 0; z-index: 100;
      display: flex; align-items: center; justify-content: center;
      background: hsl(var(--background) / 0.7);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      opacity: 0;
      pointer-events: none;
      transition: opacity .25s ease;
    }
    .toast-backdrop.open { opacity: 1; pointer-events: auto; }
    .toast-enter { animation: toastIn .35s cubic-bezier(.34,1.56,.64,1) both; }
    .toast-leave { animation: toastOut .2s ease both; }
    @keyframes toastIn {
      from { opacity: 0; transform: translateY(24px) scale(.92); }
      to   { opacity: 1; transform: translateY(0) scale(1); }
    }
    @keyframes toastOut {
      from { opacity: 1; transform: translateY(0) scale(1); }
      to   { opacity: 0; transform: translateY(16px) scale(.95); }
    }
    @media (prefers-reduced-motion: reduce) {
      .toast-enter, .toast-leave { animation-duration: .01ms !important; }
      .toast-backdrop { transition-duration: .01ms !important; }
    }

    /* Inline field validation */
    .field-error { border-color: hsl(var(--destructive)) !important; }
    .field-error:focus { --tw-ring-color: hsl(var(--destructive) / 0.5); }
    .error-msg {
      display: none; margin-top: .4rem;
      font-size: .8rem; color: hsl(var(--destructive));
    }
    .error-msg.show { display: block; animation: errSlide .25s ease both; }
    @keyframes errSlide {
      from { opacity: 0; transform: translateY(-4px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    /* Success icon pulse */
    #order-toast.success #toast-icon-success { animation: pulsePop .45s cubic-bezier(.34,1.56,.64,1) both; }
    @keyframes pulsePop {
      0% { transform: scale(0); } 70% { transform: scale(1.15); } 100% { transform: scale(1); }
    }
  </style>

  <main id="main-content" class="relative z-0 flex min-h-screen flex-col pt-20 sm:pt-16 md:pt-20">
    <div class="container mx-auto px-4 py-8 sm:py-12 max-w-4xl">
      <div class="glass-panel rounded-2xl sm:rounded-3xl p-5 sm:p-8">

        <div class="text-center mb-6 sm:mb-8 reveal">
          <h1 class="text-2xl sm:text-3xl font-bold text-foreground mb-3 sm:mb-4">{t('order.title', locale)}</h1>
          <p class="text-muted-foreground text-sm sm:text-base">{t('order.subtitle', locale)}</p>
        </div>

        <!-- Step indicator -->
        <div class="flex items-center justify-center gap-2 mb-8 reveal" aria-hidden="true">
          <span class="step-dot active h-2.5 w-2.5 rounded-full bg-foreground/20" data-step="1"></span>
          <span class="h-px w-8 bg-foreground/15"></span>
          <span class="step-dot h-2.5 w-2.5 rounded-full bg-foreground/20" data-step="2"></span>
          <span class="h-px w-8 bg-foreground/15"></span>
          <span class="step-dot h-2.5 w-2.5 rounded-full bg-foreground/20" data-step="3"></span>
        </div>

        <form id="order-form" class="space-y-6" novalidate>
          <!-- Step 1: Service -->
          <div class="reveal">
            <label class="block text-sm font-medium text-foreground mb-2">
              {t('order.selectService', locale)}
            </label>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4">
              <button type="button" data-service="web" class="service-btn glass-panel rounded-xl p-3 sm:p-4 text-center transition hover:scale-105 active:scale-[0.98] min-h-[44px]">
                <span class="block font-medium text-sm sm:text-base">{t('order.serviceCards.web.title', locale)}</span>
              </button>
              <button type="button" data-service="mobile" class="service-btn glass-panel rounded-xl p-3 sm:p-4 text-center transition hover:scale-105 active:scale-[0.98] min-h-[44px]">
                <span class="block font-medium text-sm sm:text-base">{t('order.serviceCards.mobile.title', locale)}</span>
              </button>
              <button type="button" data-service="maintenance" class="service-btn glass-panel rounded-xl p-3 sm:p-4 text-center transition hover:scale-105 active:scale-[0.98] min-h-[44px]">
                <span class="block font-medium text-sm sm:text-base">{t('order.serviceCards.maintenance.title', locale)}</span>
              </button>
            </div>
            <input type="hidden" name="service" id="selected-service" />
          </div>

          <!-- Step 2: Data -->
          <div class="reveal">
            <label for="order-name" class="block text-sm font-medium text-foreground mb-2">
              {t('order.name', locale)} *
            </label>
            <input
              id="order-name" type="text" name="name" required minlength="2"
              autocomplete="name" placeholder={t('order.namePlaceholder', locale)}
              class="w-full glass-input rounded-lg px-4 py-3 text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary/50"
            />
          </div>

          <div class="reveal">
            <label for="order-whatsapp" class="block text-sm font-medium text-foreground mb-2">
              {t('order.phone', locale)} *
            </label>
            <input
              id="order-whatsapp" type="tel" name="whatsapp" required
              autocomplete="tel" inputmode="tel" placeholder={t('order.phonePlaceholder', locale)}
              class="w-full glass-input rounded-lg px-4 py-3 text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary/50"
            />
          </div>

          <div class="reveal">
            <label for="order-description" class="block text-sm font-medium text-foreground mb-2">
              {t('order.projectDescription', locale)} *
            </label>
            <textarea
              id="order-description" name="description" required minlength="10" rows="4"
              placeholder={t('order.descriptionPlaceholder', locale)}
              class="w-full glass-input rounded-lg px-4 py-3 text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary/50 resize-none"
            ></textarea>
          </div>

          <!-- Step 3: Submit -->
          <button
            type="submit" id="submit-btn"
            class="reveal w-full flex items-center justify-center gap-2 rounded-lg bg-primary px-6 py-3.5 sm:py-4 font-semibold text-primary-foreground transition hover:bg-primary/90 active:bg-primary/80 min-h-[44px]"
          >
            {t('order.submit', locale)}
            <ArrowRight class="h-5 w-5" />
          </button>
        </form>
      </div>
    </div>

    <!-- Toast dialog (validation errors / status) -->
    <div id="order-toast-backdrop" class="toast-backdrop" aria-hidden="true">
      <div id="order-toast" role="alertdialog" aria-modal="true" aria-labelledby="order-toast-title" aria-describedby="order-toast-msg" tabindex="-1"
        class="glass-panel rounded-2xl mx-4 max-w-sm w-full p-5 shadow-2xl toast-enter outline-none">
        <div class="flex items-start gap-3">
          <div id="order-toast-icon" class="flex-shrink-0 h-10 w-10 rounded-full flex items-center justify-center bg-destructive/15 text-destructive">
            <svg id="toast-icon-error" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
            <svg id="toast-icon-success" class="hidden" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <div class="min-w-0 flex-1">
            <p id="order-toast-title" class="font-semibold text-foreground text-sm">Perhatian</p>
            <p id="order-toast-msg" class="text-muted-foreground text-sm mt-1 leading-relaxed break-words"></p>
          </div>
        </div>
        <button id="order-toast-close" type="button"
          class="mt-4 w-full rounded-lg border border-border bg-card/40 px-4 py-2.5 text-sm font-semibold text-foreground transition hover:bg-card/60 min-h-[44px]">
          OK, Saya Mengerti
        </button>
      </div>
    </div>
  </main>
</Layout>

<script>
  // Constants duplicated here because this is a client <script> (no server imports).
  const WA_BUSINESS_NUMBER = '6281999900306'

  const SERVICE_LABELS: Record<string, string> = {
    web: 'Website Development',
    mobile: 'Mobile App Development',
    maintenance: 'Maintenance Server & Web'
  }

  function normalizeWhatsapp(wa: string): string {
    let cleaned = wa.replace(/\D/g, '')
    if (cleaned.startsWith('0')) cleaned = '62' + cleaned.slice(1)
    if (!cleaned.startsWith('62')) cleaned = '62' + cleaned
    return cleaned
  }

  function isValidWhatsapp(wa: string): boolean {
    const digits = wa.replace(/\D/g, '')
    return digits.length >= 9 && digits.length <= 15
  }

  function buildWhatsAppMessage(data: {
    orderId: string
    serviceType: string
    customerName: string
    whatsapp: string
    description: string
  }): string {
    return `Halo Ekalliptus, saya ingin konsultasi order.

Detail Order:
- Order ID: ${data.orderId.slice(0, 8).toUpperCase()}
- Layanan: ${SERVICE_LABELS[data.serviceType] || data.serviceType}

Data Saya:
- Nama: ${data.customerName}
- WhatsApp: ${data.whatsapp}

Deskripsi Project:
${data.description}

Mohon info detail & penawaran. Terima kasih!`
  }

  const serviceBtns = document.querySelectorAll('.service-btn')
  const selectedServiceInput = document.getElementById('selected-service') as HTMLInputElement
  const stepDots = document.querySelectorAll('.step-dot')
  let selectedService = ''

  function setStep(n: number) {
    stepDots.forEach(d => d.classList.toggle('active', Number(d.getAttribute('data-step')) <= n))
  }

  // ---- Toast dialog ----
  const toastBackdrop = document.getElementById('order-toast-backdrop')!
  const toastEl = document.getElementById('order-toast')!
  const toastTitle = document.getElementById('order-toast-title')!
  const toastMsg = document.getElementById('order-toast-msg')!
  const iconError = document.getElementById('toast-icon-error')!
  const iconSuccess = document.getElementById('toast-icon-success')!
  let toastDismissTimer: ReturnType<typeof setTimeout> | null = null

  function showToast(opts: { type: 'error' | 'success'; title: string; message: string }) {
    if (toastDismissTimer) { clearTimeout(toastDismissTimer); toastDismissTimer = null }
    toastEl.classList.remove('success', 'toast-leave')
    void toastEl.offsetWidth // restart entry animation
    toastEl.classList.add('toast-enter')

    toastTitle.textContent = opts.title
    toastMsg.textContent = opts.message
    const isError = opts.type === 'error'
    iconError.classList.toggle('hidden', !isError)
    iconSuccess.classList.toggle('hidden', isError)
    toastEl.classList.toggle('success', !isError)
    toastBackdrop.classList.add('open')
    // alertdialog is announced only once focused; keyboard/SR users need it.
    toastEl.focus({ preventScroll: true })
  }

  function hideToast() {
    if (!toastBackdrop.classList.contains('open')) return
    toastBackdrop.classList.remove('open')
    toastEl.classList.remove('toast-enter')
    toastEl.classList.add('toast-leave')
    toastDismissTimer = setTimeout(() => {
      toastEl.classList.remove('toast-leave')
      if (toastDismissTimer) { clearTimeout(toastDismissTimer); toastDismissTimer = null }
    }, 220)
  }

  document.getElementById('order-toast-close')?.addEventListener('click', hideToast)
  toastBackdrop.addEventListener('click', (e) => {
    if (e.target === toastBackdrop) hideToast()
  })
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toastBackdrop.classList.contains('open')) hideToast()
  })

  // ---- Inline field validation ----
  const nameInput = document.getElementById('order-name') as HTMLInputElement
  const waInput = document.getElementById('order-whatsapp') as HTMLInputElement
  const descInput = document.getElementById('order-description') as HTMLTextAreaElement

  function markFieldError(el: HTMLElement, msg: string | null) {
    // Each field is followed by its <p class="error-msg"> sibling.
    const errorEl = el.parentElement?.querySelector('.error-msg') as HTMLElement | null
    el.classList.toggle('field-error', !!msg)
    el.setAttribute('aria-invalid', msg ? 'true' : 'false')
    if (errorEl) {
      errorEl.textContent = msg || ''
      errorEl.classList.toggle('show', !!msg)
      errorEl.setAttribute('aria-live', 'polite')
      if (msg) el.setAttribute('aria-describedby', errorEl.id || '')
      else el.removeAttribute('aria-describedby')
    }
  }

  nameInput.insertAdjacentHTML('afterend', '<p class="error-msg" id="error-name" aria-live="polite"></p>')
  waInput.insertAdjacentHTML('afterend', '<p class="error-msg" id="error-whatsapp" aria-live="polite"></p>')
  descInput.insertAdjacentHTML('afterend', '<p class="error-msg" id="error-description" aria-live="polite"></p>')

  function validateName(silent = false): boolean {
    const v = nameInput.value.trim()
    const ok = v.length >= 2
    if (!silent) markFieldError(nameInput, ok ? null : 'Nama minimal 2 karakter.')
    return ok
  }
  function validateWhatsapp(silent = false): boolean {
    const v = waInput.value.trim()
    if (!v) { if (!silent) markFieldError(waInput, 'Nomor WhatsApp wajib diisi.'); return false }
    const ok = isValidWhatsapp(v)
    if (!silent) markFieldError(waInput, ok ? null : 'Masukkan nomor WhatsApp yang valid (9–15 digit).')
    return ok
  }
  function validateDescription(silent = false): boolean {
    const v = descInput.value.trim()
    const ok = v.length >= 10
    if (!silent) markFieldError(descInput, ok ? null : 'Deskripsi minimal 10 karakter agar kami memahami kebutuhan Anda.')
    return ok
  }

  ;[nameInput, waInput, descInput].forEach(el => {
    el.addEventListener('blur', () => {
      if (!(el as HTMLInputElement).value.trim()) return
      if (el === nameInput) validateName()
      else if (el === waInput) validateWhatsapp()
      else validateDescription()
    })
    el.addEventListener('input', () => {
      if ((el as HTMLInputElement).classList.contains('field-error')) {
        if (el === nameInput) validateName()
        else if (el === waInput) validateWhatsapp()
        else validateDescription()
      }
    })
  })

  serviceBtns.forEach(btn => {
    btn.setAttribute('aria-pressed', 'false')
    btn.addEventListener('click', () => {
      serviceBtns.forEach(b => {
        b.classList.remove('selected')
        b.setAttribute('aria-pressed', 'false')
      })
      btn.classList.add('selected')
      btn.setAttribute('aria-pressed', 'true')
      selectedService = btn.getAttribute('data-service') || ''
      selectedServiceInput.value = selectedService
      setStep(2)
    })
  })

  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement
  const originalLabel = submitBtn.innerHTML

  document.getElementById('order-form')?.addEventListener('submit', async (e) => {
    e.preventDefault()
    if (submitBtn.disabled) return

    // First invalid field wins, scroll it into view + show inline error.
    const nameOk = validateName()
    const waOk = validateWhatsapp()
    const descOk = validateDescription()

    if (!selectedService) {
      showToast({ type: 'error', title: 'Layanan belum dipilih', message: 'Silakan pilih jenis layanan di bagian atas form terlebih dahulu.' })
      serviceBtns[0]?.scrollIntoView({ behavior: 'smooth', block: 'center' })
      return
    }
    if (!nameOk || !waOk || !descOk) {
      const firstInvalid = !nameOk ? nameInput : !waOk ? waInput : descInput
      showToast({
        type: 'error',
        title: 'Form belum lengkap',
        message: 'Beberapa kolom masih perlu diperbaiki. Periksa kolom yang ditandai merah.'
      })
      firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' })
      firstInvalid.focus({ preventScroll: true })
      return
    }

    setStep(3)
    submitBtn.disabled = true
    submitBtn.textContent = 'Menyimpan permintaan...'
    submitBtn.setAttribute('aria-busy', 'true')
    submitBtn.classList.add('async-pending')

    try {
      const response = await fetch('/api/order', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          service_type: selectedService,
          customer_name: (nameInput.value).trim(),
          whatsapp: normalizeWhatsapp(waInput.value),
          description: (descInput.value).trim()
        })
      })

      if (!response.ok) {
        const err = await response.json().catch(() => ({ error: 'Unknown error' }))
        showToast({
          type: 'error',
          title: response.status === 429 ? 'Terlalu sering mengirim' : 'Gagal membuat order',
          message: err.error || 'Silakan coba lagi beberapa saat.'
        })
        setStep(2)
        return
      }

      const result = await response.json()
      const { orderId, serviceType } = result.data

      const message = buildWhatsAppMessage({
        orderId, serviceType,
        customerName: (nameInput.value).trim(),
        whatsapp: waInput.value.trim(),
        description: (descInput.value).trim()
      })
      showToast({
        type: 'success',
        title: 'Order berhasil dibuat!',
        message: 'Anda akan diarahkan ke WhatsApp untuk konfirmasi...'
      })
      setTimeout(() => {
        window.location.href = `https://wa.me/${WA_BUSINESS_NUMBER}?text=${encodeURIComponent(message)}`
      }, 900)
    } catch (error) {
      console.error('Order error:', error)
      showToast({ type: 'error', title: 'Koneksi bermasalah', message: 'Terjadi kesalahan jaringan. Silakan coba lagi.' })
      setStep(2)
    } finally {
      submitBtn.removeAttribute('aria-busy')
      submitBtn.classList.remove('async-pending')
      submitBtn.disabled = false
      submitBtn.innerHTML = originalLabel
    }
  })

  // Scroll-reveal (respects reduced motion).
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  if (!prefersReduced && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach(en => {
        if (en.isIntersecting) {
          en.target.classList.add('reveal-in')
          io.unobserve(en.target)
        }
      })
    }, { threshold: 0.15 })
    document.querySelectorAll('.reveal').forEach(el => io.observe(el))
  } else {
    document.querySelectorAll('.reveal').forEach(el => el.classList.add('reveal-in'))
  }
</script>
