---
import '../styles/global.css'
import Footer from '../components/Footer.astro'
import { waLink } from '../lib/constants'
import { alternateLinks, canonicalUrl } from '../lib/locale-routing'

interface Props {
  title: string
  description?: string
  lang?: string
  dir?: 'ltr' | 'rtl'
  noindex?: boolean
  image?: string
  imageAlt?: string
  /** OG image dimensions, default matches /og-image.webp (1200×630). */
  imageWidth?: string | number
  imageHeight?: string | number
  type?: 'website' | 'article'
  publishedTime?: string
  modifiedTime?: string
  author?: string
  /** Search Console / Bing site verification tokens (optional). */
  googleVerification?: string
  bingVerification?: string
  adsense?: boolean
}

const {
  title,
  description = 'Digital agency spesialis website development, mobile app, dan maintenance server & web.',
  lang = 'id',
  dir = 'ltr',
  noindex = false,
  image = '/og-image.webp',
  imageAlt = 'Ekalliptus Digital: Web & Mobile App Agency',
  imageWidth = 1200,
  imageHeight = 630,
  type = 'website',
  publishedTime,
  modifiedTime,
  author,
  googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION ?? '',
  bingVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION ?? '',
  adsense = false
} = Astro.props

const siteUrl = 'https://ekalliptus.com'
const publicPathname = Astro.locals.publicPathname ?? Astro.url.pathname
const canonical = canonicalUrl(publicPathname, siteUrl)
const alternates = alternateLinks(publicPathname)
const shouldNoindex = noindex || Astro.locals.indexable === false
const ogImage = new URL(image, siteUrl).toString()
const ogImageWidth = String(imageWidth)
const ogImageHeight = String(imageHeight)

const ogLocaleMap: Record<string, string> = {
  id: 'id_ID', en: 'en_US', ja: 'ja_JP',
  ko: 'ko_KR', ru: 'ru_RU', ar: 'ar_SA', tr: 'tr_TR'
}
const ogLocale = ogLocaleMap[lang] ?? 'id_ID'

const publishedYMD = publishedTime ? publishedTime.slice(0, 10).replace(/-/g, '/') : undefined
---

<!DOCTYPE html>
<html lang={lang} dir={dir} class="scroll-smooth" data-adsense={adsense ? 'true' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    {author && <meta name="author" content={author} />}
    <meta name="format-detection" content="telephone=no" />
    <meta name="robots" content={shouldNoindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta name="theme-color" content="#132237" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f5f8fa" media="(prefers-color-scheme: light)" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonical} />
    {alternates.map(({ locale, href }) => <link rel="alternate" hreflang={locale} href={href} />)}
    <link rel="alternate" type="application/rss+xml" title="Ekalliptus Digital Blog" href="/blog/rss.xml" />
    <link rel="alternate" type="application/feed+json" title="Ekalliptus Digital Blog" href="/blog/feed.json" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-latin-400-normal.woff2" crossorigin />

    <title>{title}</title>

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Ekalliptus Digital" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={ogImageWidth} />
    <meta property="og:image:height" content={ogImageHeight} />
    {/\.webp(?:$|[?#])/i.test(ogImage) && <meta property="og:image:type" content="image/webp" />}
    {/\.png(?:$|[?#])/i.test(ogImage) && <meta property="og:image:type" content="image/png" />}
    {/\.jpe?g(?:$|[?#])/i.test(ogImage) && <meta property="og:image:type" content="image/jpeg" />}
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content={ogLocale} />

    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {type === 'article' && author && <meta property="article:author" content={author} />}

    {type === 'article' && publishedYMD && <meta name="citation_title" content={title} />}
    {type === 'article' && author && <meta name="citation_author" content={author} />}
    {type === 'article' && publishedYMD && <meta name="citation_publication_date" content={publishedYMD} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@ekalliptus" />
    <meta name="twitter:creator" content="@ekalliptus" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {/* Search Console / Bing verification, render only when configured */}
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    {bingVerification && <meta name="msvalidate.01" content={bingVerification} />}

    <slot name="head" />

    <!-- 3rd-party scripts (AdSense + GA4), deferred to FIRST user interaction so
         they never enter the critical rendering path (huge PageSpeed win: ~545KB JS). -->
    <script is:inline>
      (function () {
        var loaded = false;
        function loadThirdParty() {
          if (loaded) return;
          loaded = true;

          // Google AdSense, only on pages that render ad units.
          if (document.documentElement.dataset.adsense === 'true') {
            var ads = document.createElement('script');
            ads.async = true;
            ads.crossOrigin = 'anonymous';
            ads.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9374589831001594';
            document.head.appendChild(ads);
          }

          // Google Analytics 4
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { dataLayer.push(arguments); };
          var ga = document.createElement('script');
          ga.async = true;
          ga.src = 'https://www.googletagmanager.com/gtag/js?id=G-HQL55M3RTK';
          ga.onload = function () {
            gtag('js', new Date());
            gtag('config', 'G-HQL55M3RTK', { send_page_view: true });
          };
          document.head.appendChild(ga);
        }

        // Trigger only after a real user interaction; no automatic fallback.
        var events = ['scroll', 'click', 'touchstart', 'keydown'];
        function onInteract() {
          loadThirdParty();
          events.forEach(function (e) { document.removeEventListener(e, onInteract, true); });
        }
        events.forEach(function (e) { document.addEventListener(e, onInteract, { passive: true, capture: true }); });
      })();
    </script>

    <script is:inline>
      const theme = localStorage.getItem('ekal-theme') || 'light'
      document.documentElement.classList.toggle('dark', theme === 'dark')
    </script>

    <!-- Service worker, runtime cache for fonts, vendor scripts, images -->
    <script is:inline>
      if ('serviceWorker' in navigator && location.protocol === 'https:') {
        const register = () => navigator.serviceWorker.register('/sw.js').catch(() => {});
        if ('requestIdleCallback' in window) {
          requestIdleCallback(register, { timeout: 5000 });
        } else {
          window.addEventListener('load', register, { once: true });
        }
      }
    </script>
  </head>
  <body class="bg-background text-foreground antialiased min-h-screen">
    <noscript>
      <div style="padding:2rem;text-align:center;font-family:system-ui,sans-serif;">
        <p style="font-size:1.5rem;font-weight:700;">Ekalliptus Digital</p>
        <p>Javascript diperlukan untuk melihat website ini dengan baik.</p>
        <p>Hubungi kami: <a href="mailto:salam@ekalliptus.com">salam@ekalliptus.com</a> | <a href={waLink()}>WhatsApp</a></p>
        <p><a href="/">Kembali ke Beranda</a> | <a href="/order">Order Layanan</a></p>
      </div>
    </noscript>
    <a href="#main-content" class="skip-link">{lang === 'id' ? 'Langsung ke konten' : 'Skip to content'}</a>
    <slot />
    <Footer />
    <script>
      const main = document.querySelector('main')
      if (main) { main.id = 'main-content'; main.tabIndex = -1 }
      document.querySelectorAll<HTMLImageElement>('main img[loading="lazy"]').forEach(image => {
        const finish = () => { image.classList.remove('image-pending'); image.removeAttribute('aria-busy') }
        image.addEventListener('load', finish, { once: true })
        image.addEventListener('error', finish, { once: true })
        if (!image.complete) { image.classList.add('image-pending'); image.setAttribute('aria-busy', 'true') }
      })
    </script>
  </body>
</html>
