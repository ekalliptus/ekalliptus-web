---
import { serializeJsonLd } from '../lib/article-html'

interface Props {
  locale?: string
  faqItems?: Array<{ question: string; answer: string }>
}

const { locale = 'id', faqItems = [] } = Astro.props
const siteUrl = 'https://ekalliptus.com'
const organizationId = `${siteUrl}#organization`

const organization = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'ProfessionalService'],
  '@id': organizationId,
  name: 'Ekalliptus Digital',
  url: siteUrl,
  logo: `${siteUrl}/ekalliptus_rounded.webp`,
  image: `${siteUrl}/og-image.webp`,
  description: 'Digital agency Indonesia untuk pengembangan website, aplikasi mobile, UI/UX design, serta maintenance server dan web.',
  email: 'salam@ekalliptus.com',
  telephone: '+6281999900306',
  foundingDate: '2023',
  priceRange: 'IDR 1000000 - 50000000',
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'ID'
  },
  areaServed: { '@type': 'Country', name: 'Indonesia' },
  knowsAbout: [
    'Web Development',
    'Mobile App Development',
    'UI/UX Design',
    'Progressive Web Apps (PWA)',
    'Website Maintenance',
    'WordPress Optimization',
    'Search Engine Optimization (SEO)',
    'Generative Engine Optimization (GEO)'
  ],
  sameAs: [
    'https://www.linkedin.com/company/ekalliptus',
    'https://github.com/ekalliptus',
    'https://www.instagram.com/ekalliptus'
  ]
}

const webSite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}#website`,
  name: 'Ekalliptus Digital',
  url: siteUrl,
  inLanguage: locale,
  publisher: { '@id': organizationId }
}

// Translated pages are noindex, so the FAQ schema is only emitted for the
// canonical Indonesian page (answers fall back to Indonesian elsewhere).
const faqSchema = locale === 'id' && faqItems.length ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(item => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer }
  }))
} : null

const schemas = [organization, webSite, ...(faqSchema ? [faqSchema] : [])]
---

{schemas.map(schema => <script type="application/ld+json" set:html={serializeJsonLd(schema)} />)}
