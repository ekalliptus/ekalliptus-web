---
import { X, MessageCircle } from 'lucide-astro'
---

<!--
  Floating eBot AI button + greeting card.
  - Greeting appears on FIRST scroll (not on load).
  - Opens the existing ConsultationDialog via window.consultDialog.open().
  - Render on pages that include <ConsultationDialog /> (e.g. homepage).
-->
<div id="ebot-fab" class="fixed bottom-5 right-5 sm:bottom-6 sm:right-6 z-40 flex flex-col items-end gap-3 safe-bottom" aria-live="polite">
  <!-- Greeting card (hidden until first scroll) -->
  <div id="ebot-greeting" class="ebot-greeting glass-panel rounded-2xl rounded-br-sm px-4 py-3 shadow-xl max-w-[270px] ebot-hidden">
    <button id="ebot-greeting-close" class="absolute -top-2 -right-2 h-8 w-8 rounded-full bg-card border border-border flex items-center justify-center transition hover:bg-accent cursor-interactive" aria-label="Tutup sapaan">
      <X class="h-3.5 w-3.5 text-muted-foreground" />
    </button>
    <p class="font-semibold text-primary mb-1 text-sm">Halo! 👋</p>
    <p class="text-sm text-foreground/80 leading-relaxed">Ada yang bisa kami bantu? Konsultasi gratis seputar kebutuhan digital Anda.</p>
  </div>

  <!-- Floating button -->
  <button
    id="ebot-trigger"
    class="group relative flex h-14 w-14 sm:h-16 sm:w-16 items-center justify-center rounded-full bg-primary text-primary-foreground shadow-lg shadow-primary/30 transition-all duration-300 hover:scale-105 hover:bg-primary/90 active:scale-95 cursor-interactive"
    aria-label="Buka chat eBot"
  >
    <span class="absolute inset-0 rounded-full bg-primary animate-ping opacity-20"></span>
    <MessageCircle class="relative h-6 w-6 sm:h-7 sm:w-7" />
    <span class="sr-only">eBot</span>
  </button>
</div>

<style>
  .ebot-greeting {
    position: relative;
    transform-origin: bottom right;
  }
  .ebot-greeting.ebot-hidden {
    display: none;
  }
  .ebot-greeting.ebot-show {
    display: block;
    animation: ebotSlideIn 0.4s ease-out;
  }
  @keyframes ebotSlideIn {
    from { opacity: 0; transform: translateY(10px) scale(0.95); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ebot-greeting.ebot-show { animation: none; }
  }
</style>

<script>
  (function () {
    const greeting = document.getElementById('ebot-greeting')
    const greetingClose = document.getElementById('ebot-greeting-close')
    const trigger = document.getElementById('ebot-trigger')

    if (!trigger) return

    // Show greeting on FIRST scroll only (once per session).
    const SESSION_KEY = 'ebot-greeting-seen'
    let scrollHandled = false
    let autoHideTimer: number | undefined

    function showGreetingOnce() {
      if (scrollHandled) return
      scrollHandled = true
      if (sessionStorage.getItem(SESSION_KEY)) {
        greeting?.classList.add('ebot-hidden')
        return
      }
      sessionStorage.setItem(SESSION_KEY, '1')
      greeting?.classList.remove('ebot-hidden')
      greeting?.classList.add('ebot-show')
      // A greeting that never leaves blocks the footer content it floats over.
      autoHideTimer = window.setTimeout(hideGreeting, 7000)
    }

    // Trigger on first scroll, or after 8s if the user never scrolls.
    window.addEventListener('scroll', showGreetingOnce, { once: true, passive: true })
    const fallbackTimer = window.setTimeout(showGreetingOnce, 8000)

    // Dismiss greeting card.
    function hideGreeting() {
      window.clearTimeout(autoHideTimer)
      greeting?.classList.add('ebot-hidden')
    }
    greetingClose?.addEventListener('click', hideGreeting)

    // Open the ConsultationDialog when the FAB is clicked.
    const openDialog = () => {
      window.clearTimeout(fallbackTimer)
      const dlg = (window as any).consultDialog
      if (dlg && typeof dlg.open === 'function') {
        dlg.open()
      } else {
        document.getElementById('contact')?.scrollIntoView({ behavior: 'smooth' })
      }
      hideGreeting()
    }
    trigger.addEventListener('click', openDialog)
  })()
</script>
