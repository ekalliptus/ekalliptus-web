---
import { Menu, X, Moon, Sun, ArrowUpRight, Languages } from 'lucide-astro'
import { localizedPath, type Locale } from '../lib/locale-routing'

interface Props {
  t: (key: string) => string
  currentLang?: string
}

const { t, currentLang = 'id' } = Astro.props

const sectionLinks = [
  { key: 'home', hash: '#home' },
  { key: 'services', hash: '#services', dropdown: true },
  // Blog exists only in Indonesian; localized blog URLs 404, so this link
  // must always target /id/blog regardless of the active locale.
  { key: 'blog', href: '/id/blog', external: true, fixedLocale: true },
  { key: 'about', href: '/about', external: true },
  { key: 'contact', hash: '#contact' }
]

const serviceItems = [
  { key: 'websiteDevelopment', href: '/services/website' },
  { key: 'mobileAppDevelopment', href: '/services/mobile-app' },
  { key: 'websiteMaintenance', href: '/services/maintenance' }
]

const languages = [
  { code: 'id', name: 'Bahasa Indonesia', flag: '/flags/id.svg', nativeName: 'Indonesia' },
  { code: 'en', name: 'English', flag: '/flags/us.svg', nativeName: 'English' },
  { code: 'ja', name: '日本語', flag: '/flags/jp.svg', nativeName: '日本語' },
  { code: 'ko', name: '한국어', flag: '/flags/kr.svg', nativeName: '한국어' },
  { code: 'ru', name: 'Русский', flag: '/flags/ru.svg', nativeName: 'Русский' },
  { code: 'ar', name: 'العربية', flag: '/flags/sa.svg', nativeName: 'العربية' },
  { code: 'tr', name: 'Türkçe', flag: '/flags/tr.svg', nativeName: 'Türkçe' }
]

const currentLanguage = languages.find(lang => lang.code === currentLang) || languages[0]

const currentPath = Astro.locals.publicPathname ?? Astro.url.pathname
const publicPath = (path: string) => localizedPath(path, currentLang as Locale)
const isHomePage = currentPath === publicPath('/')

// Blog articles are Indonesian-only: every localized variant of a blog URL is a
// dead end, so on blog routes only the Indonesian language option navigates.
const barePath = currentPath.replace(/[?#].*$/, '')
const isBlogRoute = barePath === '/id/blog' || barePath.startsWith('/id/blog/') || barePath === '/blog' || barePath.startsWith('/blog/')
const blogUnavailableNotice = 'Artikel hanya tersedia dalam Bahasa Indonesia'
---

<header class="site-header fixed inset-x-0 top-0 z-40 safe-top">
  <nav
    id="main-nav"
    class="site-navigation flex items-center justify-between"
  >
    <a
      href={publicPath("/")}
      class="cursor-interactive flex items-center rounded-full px-1 py-0.5 transition text-foreground"
    >
      <img src="/logo_mobile.webp" alt="Ekalliptus Digital" width="200" height="133" class="h-[44px] sm:h-[48px] w-auto transition-opacity hover:opacity-90 invert dark:invert-0" loading="eager" fetchpriority="high" decoding="async" />
    </a>

    <div class="hidden items-center gap-0.5 md:flex" id="desktop-nav">
      {sectionLinks.map((item) => (
        item.dropdown ? (
          <div class="relative group">
            <button
              type="button"
              class="nav-link cursor-interactive rounded-full px-3 py-1 text-[13px] font-medium text-foreground/80 transition hover:bg-foreground/10 hover:text-foreground"
              data-hash={item.hash}
              aria-haspopup="true"
              aria-expanded="false"
            >
              {t(`nav.${item.key}`)}
            </button>
            <div class="absolute left-1/2 top-full -translate-x-1/2 mt-2 w-60 rounded-2xl glass-panel border border-border/20 p-2 opacity-0 invisible -translate-y-2 group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 group-focus-within:translate-y-0 group-hover:visible group-hover:translate-y-0 transition-all duration-300 z-50">
              {serviceItems.map((s) => (
                <a
                  href={publicPath(s.href)}
                  class="service-link relative block overflow-hidden rounded-lg px-3 py-2.5 text-sm font-medium text-foreground/80 transition-colors duration-500"
                >
                  <span class="relative z-10 truncate">{t(`services.cards.${s.key}.title`)}</span>
                </a>
              ))}
            </div>
          </div>
        ) : item.external ? (
          <a
            href={item.fixedLocale ? item.href! : publicPath(item.href!)}
            class="nav-link cursor-interactive rounded-full px-3 py-1 text-[13px] font-medium text-foreground/80 transition hover:bg-foreground/10 hover:text-foreground"
          >
            {t(`nav.${item.key}`)}
          </a>
        ) : isHomePage ? (
          <button
            type="button"
            data-hash={item.hash}
            class="nav-link cursor-interactive rounded-full px-3 py-1 text-[13px] font-medium text-foreground/80 transition hover:bg-foreground/10 hover:text-foreground"
          >
            {t(`nav.${item.key}`)}
          </button>
        ) : (
          <a
            href={`${publicPath("/")}${item.hash}`}
            class="nav-link cursor-interactive rounded-full px-3 py-1 text-[13px] font-medium text-foreground/80 transition hover:bg-foreground/10 hover:text-foreground"
          >
            {t(`nav.${item.key}`)}
          </a>
        )
      ))}
    </div>

    <div class="flex items-center gap-1.5">
      <button
        id="theme-toggle"
        class="cursor-interactive hidden h-9 w-9 items-center justify-center rounded-full transition hover:bg-card/20 md:flex"
        aria-label="Toggle theme"
      >
        <Moon class="h-[17px] w-[17px] dark-icon" />
        <Sun class="h-[17px] w-[17px] light-icon hidden" />
      </button>

      <button
        id="lang-toggle"
        class="cursor-interactive hidden items-center gap-1.5 rounded-full px-2.5 py-1.5 text-sm font-medium transition hover:bg-card/20 md:flex"
        aria-label="Change language"
      >
        <img src={currentLanguage.flag} alt="" width="20" height="15" class="shrink-0" />
        <span class="hidden lg:inline text-xs">{currentLanguage.nativeName}</span>
        <Languages class="h-3.5 w-3.5" />
      </button>

      <button
        id="mobile-menu-toggle"
        class="cursor-interactive flex h-9 w-9 items-center justify-center rounded-full glass-panel transition md:hidden"
        aria-label="Toggle menu"
      >
        <Menu class="h-5 w-5 menu-icon" />
        <X class="h-5 w-5 close-icon hidden" />
      </button>
    </div>
  </nav>
</header>

<div id="mobile-backdrop" class="fixed inset-0 z-30 bg-background/80 backdrop-blur-sm md:hidden hidden"></div>

<div id="mobile-menu" class="fixed inset-x-2 top-2 z-40 max-h-[calc(100dvh-1rem)] overflow-y-auto rounded-2xl border border-border bg-card p-3 shadow-lg md:hidden hidden custom-scrollbar safe-top">
    <div class="flex items-center justify-end mb-1">
      <button id="mobile-menu-close" class="cursor-interactive flex h-11 w-11 items-center justify-center rounded-full transition hover:bg-accent" aria-label="Close menu">
        <X class="h-4 w-4" />
      </button>
    </div>
    <nav class="flex flex-col gap-1">
    {sectionLinks.map((item) => (
      item.dropdown ? (
        <>
          {isHomePage ? (
            <button
              type="button"
              data-hash={item.hash}
              class="nav-link cursor-interactive rounded-lg px-4 py-3 text-left text-sm font-medium text-foreground/80 transition hover:bg-accent hover:text-foreground active:bg-accent/80"
            >
              {t(`nav.${item.key}`)}
            </button>
          ) : (
            <a
              href={`${publicPath("/")}${item.hash}`}
              class="nav-link cursor-interactive rounded-lg px-4 py-3 text-left text-sm font-medium text-foreground/80 transition hover:bg-accent hover:text-foreground active:bg-accent/80"
            >
              {t(`nav.${item.key}`)}
            </a>
          )}
          <div class="ml-4 flex flex-col gap-1 mb-1">
            {serviceItems.map(s => (
              <a href={publicPath(s.href)} class="rounded-lg px-3 py-2 text-xs text-foreground/70 hover:bg-accent hover:text-foreground transition">
                {t(`services.cards.${s.key}.title`)}
              </a>
            ))}
          </div>
        </>
      ) : item.external ? (
        <a
          href={item.fixedLocale ? item.href! : publicPath(item.href!)}
          class="nav-link cursor-interactive rounded-lg px-4 py-3 text-left text-sm font-medium text-foreground/80 transition hover:bg-accent hover:text-foreground active:bg-accent/80"
        >
          {t(`nav.${item.key}`)}
        </a>
      ) : isHomePage ? (
        <button
          type="button"
          data-hash={item.hash}
          class="nav-link cursor-interactive rounded-lg px-4 py-3 text-left text-sm font-medium text-foreground/80 transition hover:bg-accent hover:text-foreground active:bg-accent/80"
        >
          {t(`nav.${item.key}`)}
        </button>
      ) : (
        <a
          href={`${publicPath("/")}${item.hash}`}
          class="nav-link cursor-interactive rounded-lg px-4 py-3 text-left text-sm font-medium text-foreground/80 transition hover:bg-accent hover:text-foreground active:bg-accent/80"
        >
          {t(`nav.${item.key}`)}
        </a>
      )
    ))}
  </nav>

  <div class="my-2 border-t border-border"></div>

    <div class="space-y-2">
    <span class="px-4 text-xs font-medium uppercase tracking-wider text-muted-foreground">
      {t('nav.language')}
    </span>
    <div class="grid grid-cols-2 gap-2 px-1">
      {languages.map((lang) => (isBlogRoute && lang.code !== 'id') ? (
        <button
          type="button"
          disabled
          title={blogUnavailableNotice}
          aria-label={blogUnavailableNotice}
          aria-disabled="true"
          data-lang={lang.code}
          class="lang-btn flex items-center gap-2 rounded-lg px-3 py-2.5 text-sm opacity-40 cursor-not-allowed"
        >
          <img src={lang.flag} alt="" width="24" height="18" class="shrink-0" />
          <span class="text-xs truncate">{lang.name}</span>
        </button>
      ) : (
        <a
          href={localizedPath(currentPath, lang.code as Locale)}
          data-lang={lang.code}
          class:list={[
            'lang-btn flex items-center gap-2 rounded-lg px-3 py-2.5 text-sm transition active:scale-[0.98]',
            { 'language-active': lang.code === currentLang }
          ]}
          data-active={lang.code === currentLang}
        >
          <img src={lang.flag} alt="" width="24" height="18" class="shrink-0" />
          <span class="text-xs truncate">{lang.name}</span>
        </a>
      ))}
    </div>
  </div>

  <div class="my-2 border-t border-border"></div>

  <a
    href={publicPath("/order")}
    class="flex w-full items-center justify-center gap-2 rounded-lg bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground transition hover:bg-primary/90 active:bg-primary/80 min-h-[44px]"
  >
    {t('nav.consultation')}
    <ArrowUpRight class="h-4 w-4" />
  </a>

  <button
    id="mobile-theme-toggle"
    class="mt-2 flex w-full items-center justify-center gap-2 rounded-lg border border-border py-3 text-sm font-medium transition cursor-interactive hover:bg-accent active:bg-accent/80 min-h-[44px]"
  >
    <Moon class="h-4 w-4 dark-icon" />
    <Sun class="h-4 w-4 light-icon hidden" />
    <span class="theme-text">{t('nav.darkMode')}</span>
  </button>
</div>

<div id="language-backdrop" class="fixed inset-0 z-50 modal-backdrop hidden"></div>

<div id="language-modal" class="fixed inset-0 z-50 items-center justify-center p-4 hidden">
  <div class="w-full max-w-sm rounded-2xl language-modal p-6 shadow-2xl">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-lg font-semibold text-foreground">
        {t('nav.selectLanguage') || 'Select Language'}
      </h3>
      <button
        id="close-lang-modal" aria-label={t('nav.closeModal')}
        class="h-11 w-11 rounded-full flex items-center justify-center cursor-interactive hover:bg-card/20"
      >
        <X class="h-4 w-4" />
      </button>
    </div>

    <div class="grid grid-cols-2 gap-3">
      {languages.map((lang) => (isBlogRoute && lang.code !== 'id') ? (
        <button
          type="button"
          disabled
          title={blogUnavailableNotice}
          aria-label={blogUnavailableNotice}
          aria-disabled="true"
          data-lang={lang.code}
          class="lang-modal-btn language-button group flex flex-col items-center gap-2 rounded-xl px-3 py-4 text-center opacity-40 cursor-not-allowed"
        >
          <img src={lang.flag} alt="" width="40" height="30" class="shrink-0" />
          <div class="flex flex-col items-center">
            <span class="text-sm font-medium leading-tight">{lang.nativeName}</span>
            <span class="text-xs text-muted-foreground leading-tight">{lang.name}</span>
          </div>
        </button>
      ) : (
        <a
          href={localizedPath(currentPath, lang.code as Locale)}
          data-lang={lang.code}
          class:list={[
            'lang-modal-btn language-button group flex flex-col items-center gap-2 rounded-xl px-3 py-4 text-center transition-all duration-300',
            { 'language-active': lang.code === currentLang }
          ]}
          data-active={lang.code === currentLang}
        >
          <img src={lang.flag} alt="" width="40" height="30" class="shrink-0 group-hover:scale-110 transition-transform duration-300" />
          <div class="flex flex-col items-center">
            <span class="text-sm font-medium leading-tight">{lang.nativeName}</span>
            <span class="text-xs text-muted-foreground leading-tight">{lang.name}</span>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-4 text-center">
      <p class="text-xs text-muted-foreground">
        {t('nav.languageHint') || 'Language preference will be saved automatically'}
      </p>
    </div>
  </div>
</div>

<script define:vars={{ isHomePage }}>
  const nav = document.getElementById('main-nav')
  const mobileToggle = document.getElementById('mobile-menu-toggle')
  const mobileMenu = document.getElementById('mobile-menu')
  const mobileBackdrop = document.getElementById('mobile-backdrop')
  const langToggle = document.getElementById('lang-toggle')
  const langModal = document.getElementById('language-modal')
  const langBackdrop = document.getElementById('language-backdrop')
  const closeLangModal = document.getElementById('close-lang-modal')
  const themeToggle = document.getElementById('theme-toggle')
  const mobileThemeToggle = document.getElementById('mobile-theme-toggle')
  const menuIcon = document.querySelector('.menu-icon')
  const closeIcon = document.querySelector('.close-icon')
  
  let menuOpen = false
  let langModalOpen = false
  mobileToggle?.setAttribute('aria-controls', 'mobile-menu')
  langToggle?.setAttribute('aria-controls', 'language-modal')
  for (const [panel, toggle] of [[mobileMenu, mobileToggle], [langModal, langToggle]]) {
    if (!panel || !toggle) continue
    toggle.setAttribute('aria-expanded', 'false')
    new MutationObserver(() => {
      toggle.setAttribute('aria-expanded', String(!panel.classList.contains('hidden')))
    }).observe(panel, { attributes: true, attributeFilter: ['class'] })
  }
  
  if (mobileToggle && mobileMenu && mobileBackdrop) {
    mobileToggle.addEventListener('click', () => {
      menuOpen = !menuOpen
      mobileMenu.classList.toggle('hidden', !menuOpen)
      mobileBackdrop.classList.toggle('hidden', !menuOpen)
      if (menuIcon) menuIcon.classList.toggle('hidden', menuOpen)
      if (closeIcon) closeIcon.classList.toggle('hidden', !menuOpen)
    })
    
    mobileBackdrop.addEventListener('click', () => {
      menuOpen = false
      mobileMenu.classList.add('hidden')
      mobileBackdrop.classList.add('hidden')
      if (menuIcon) menuIcon.classList.remove('hidden')
      if (closeIcon) closeIcon.classList.add('hidden')
    })
    
    var mobileMenuClose = document.getElementById('mobile-menu-close')
    if (mobileMenuClose) {
      mobileMenuClose.addEventListener('click', function() {
        menuOpen = false
        mobileMenu.classList.add('hidden')
        mobileBackdrop.classList.add('hidden')
        if (menuIcon) menuIcon.classList.remove('hidden')
        if (closeIcon) closeIcon.classList.add('hidden')
      })
    }
  }
  
  // Keep the services dropdown's aria-expanded in sync with its CSS-driven
  // hover/focus visibility so screen readers announce the state.
  document.querySelectorAll('#desktop-nav .group').forEach(function (group) {
    const trigger = group.querySelector('button[aria-haspopup]')
    if (!trigger) return
    const setOpen = function () { trigger.setAttribute('aria-expanded', 'true') }
    const setClosed = function () { trigger.setAttribute('aria-expanded', 'false') }
    group.addEventListener('mouseenter', setOpen)
    group.addEventListener('mouseleave', setClosed)
    group.addEventListener('focusin', setOpen)
    group.addEventListener('focusout', setClosed)
  })

  if (langToggle && langModal && langBackdrop && closeLangModal) {
    const focusLangModal = () => {
      const first = langModal.querySelector('button, a[href]')
      if (!first) return
      void langModal.offsetWidth
      first.focus()
    }
    langToggle.addEventListener('click', () => {
      langModalOpen = true
      langModal.classList.remove('hidden')
      langModal.classList.add('flex')
      langBackdrop.classList.remove('hidden')
      focusLangModal()
    })

    const closeModal = () => {
      langModalOpen = false
      langModal.classList.remove('flex')
      langModal.classList.add('hidden')
      langBackdrop.classList.add('hidden')
      langToggle.focus()
    }

    // Keep Tab cycling inside the modal while it is open (standard focus trap).
    langModal.addEventListener('keydown', (e) => {
      if (!langModalOpen || e.key !== 'Tab') return
      const focusables = Array.from(langModal.querySelectorAll('button:not([disabled]), a[href]')).filter(el => el.getClientRects().length)
      if (focusables.length === 0) return
      const first = focusables[0]
      const last = focusables[focusables.length - 1]
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus() }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus() }
      else if (!langModal.contains(document.activeElement)) { e.preventDefault(); first.focus() }
    })

    closeLangModal.addEventListener('click', closeModal)
    langBackdrop.addEventListener('click', closeModal)
  }
  
  function toggleTheme(event) {
    const root = document.documentElement
    const isDark = root.classList.contains('dark')
    const newDark = !isDark
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    // Capture click origin for circular reveal
    const target = event && event.currentTarget
    let cx = '50%', cy = '50%'
    if (target && target.getBoundingClientRect) {
      const r = target.getBoundingClientRect()
      cx = (r.left + r.width / 2) + 'px'
      cy = (r.top + r.height / 2) + 'px'
    }
    root.style.setProperty('--theme-x', cx)
    root.style.setProperty('--theme-y', cy)

    const apply = () => {
      root.classList.toggle('dark', newDark)
      localStorage.setItem('ekal-theme', newDark ? 'dark' : 'light')
      updateThemeIcons(newDark)
    }

    // Modern path: View Transitions API (Chrome/Edge/Safari 18+)
    if (!reduced && document.startViewTransition) {
      const transition = document.startViewTransition(apply)
      transition.finished.catch(() => {})
      return
    }

    // Fallback: scoped CSS transitions
    root.classList.add('theme-transitioning')
    apply()
    window.setTimeout(function () {
      root.classList.remove('theme-transitioning')
    }, 360)
  }
  
  function updateThemeIcons(isDark) {
    document.querySelectorAll('.dark-icon').forEach(function(el) {
      el.classList.toggle('hidden', isDark)
    })
    document.querySelectorAll('.light-icon').forEach(function(el) {
      el.classList.toggle('hidden', !isDark)
    })
  }
  
  if (themeToggle) themeToggle.addEventListener('click', toggleTheme)
  if (mobileThemeToggle) mobileThemeToggle.addEventListener('click', toggleTheme)
  
  var savedTheme = localStorage.getItem('ekal-theme') || 'light'
  updateThemeIcons(savedTheme === 'dark')
  
  var scrolled = false
  window.addEventListener('scroll', function() {
    var newScrolled = window.scrollY > 32
    if (newScrolled !== scrolled && nav) {
      scrolled = newScrolled
      nav.classList.toggle('nav-scrolled', scrolled)
    }
  }, { passive: true })
  
  // Only handle scroll on homepage
  if (isHomePage) {
    document.querySelectorAll('.nav-link[data-hash]').forEach(function(link) {
      link.addEventListener('click', function(e) {
        var hash = e.currentTarget.dataset.hash
        if (hash) {
          var id = hash.replace('#', '')
          var target = document.getElementById(id)
          if (target) {
            target.scrollIntoView({ behavior: 'smooth', block: 'start' })
          }
          if (menuOpen && mobileMenu) {
            menuOpen = false
            mobileMenu.classList.add('hidden')
            if (mobileBackdrop) mobileBackdrop.classList.add('hidden')
            if (menuIcon) menuIcon.classList.remove('hidden')
            if (closeIcon) closeIcon.classList.add('hidden')
          }
        }
      })
    })
  }
  
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      if (langModalOpen && langModal && langBackdrop) {
        langModalOpen = false
        langModal.classList.remove('flex')
        langModal.classList.add('hidden')
        langBackdrop.classList.add('hidden')
        langToggle?.focus()
      }
      if (menuOpen && mobileMenu && mobileBackdrop) {
        menuOpen = false
        mobileMenu.classList.add('hidden')
        mobileBackdrop.classList.add('hidden')
        if (menuIcon) menuIcon.classList.remove('hidden')
        if (closeIcon) closeIcon.classList.add('hidden')
      }
    }
  })

</script>
