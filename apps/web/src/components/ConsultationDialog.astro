---
import { X, Send } from 'lucide-astro'

interface Props {
  t: (key: string) => string
}

const { t } = Astro.props
---

<div id="consult-dialog" class="fixed inset-0 z-50 hidden">
  <div id="consult-backdrop" class="fixed inset-0 modal-backdrop transition-opacity duration-300"></div>

  <div class="fixed inset-0 flex items-end justify-end p-0 sm:p-0 pointer-events-none">
    <div id="consult-panel" role="dialog" aria-modal="true" aria-labelledby="consult-title" class="pointer-events-auto relative w-full sm:w-[400px] flex flex-col bg-card border border-border rounded-t-3xl sm:rounded-3xl shadow-2xl overflow-hidden transition-transform duration-300 translate-y-full opacity-0 sm:mb-2 sm:mr-2 mb-safe max-h-[100dvh] sm:max-h-[calc(100dvh-7rem)]">

      <div class="flex items-center justify-between p-4 border-b border-border bg-card/80 backdrop-blur-xl">
        <div class="flex items-center gap-3">
          <div class="h-9 w-9 rounded-full bg-green-500/20 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5 text-green-600" aria-hidden="true"><path d="M12.04 2a9.9 9.9 0 0 0-8.51 14.94L2 22l5.2-1.5A9.9 9.9 0 1 0 12.04 2Zm5.8 14.04c-.24.68-1.4 1.3-1.96 1.35-.5.05-1.13.07-3.23-.9-2.7-1.24-4.4-4.02-4.54-4.21-.13-.19-1.07-1.47-1.07-2.8 0-1.34.7-2 .95-2.27.24-.27.52-.34.7-.34h.5c.16 0 .38-.06.59.45.24.57.81 1.99.88 2.13.07.14.12.31.02.5-.09.19-.14.31-.28.48-.14.17-.3.38-.42.5-.14.14-.29.3-.13.58.17.28.74 1.23 1.6 1.99 1.1.99 2.03 1.3 2.32 1.44.29.14.46.12.63-.07.17-.2.72-.85.91-1.14.19-.29.38-.24.64-.14.26.09 1.66.78 1.94.93.28.14.47.21.54.33.07.12.07.7-.17 1.38Z"/></svg>
          </div>
          <div>
            <h3 id="consult-title" class="text-sm font-semibold text-foreground">{t('waForm.title')}</h3>
            <div class="flex items-center gap-1.5">
              <span class="h-1.5 w-1.5 rounded-full bg-green-500 animate-pulse"></span>
              <span class="text-[0.65rem] text-muted-foreground">{t('waForm.statusNote')}</span>
            </div>
          </div>
        </div>
        <button id="consult-close" class="h-11 w-11 rounded-full flex items-center justify-center transition hover:bg-accent cursor-interactive" aria-label="Close">
          <X class="h-4 w-4 text-muted-foreground" />
        </button>
      </div>

      <form id="wa-form" class="flex-1 overflow-y-auto p-4 space-y-3 custom-scrollbar" novalidate>
        <div>
          <label for="wa-name" class="mb-1 block text-xs font-medium text-muted-foreground">{t('waForm.name')}</label>
          <input
            id="wa-name"
            type="text"
            required
            maxlength="60"
            autocomplete="name"
            placeholder={t('waForm.namePlaceholder')}
            class="w-full glass-input rounded-xl px-4 py-2.5 text-sm text-foreground placeholder:text-muted-foreground outline-none"
          />
        </div>
        <div>
          <label for="wa-need" class="mb-1 block text-xs font-medium text-muted-foreground">{t('waForm.need')}</label>
          <select
            id="wa-need"
            class="w-full glass-input rounded-xl px-4 py-2.5 text-sm text-foreground outline-none"
          >
            <option value="website">{t('waForm.needWebsite')}</option>
            <option value="mobile">{t('waForm.needMobile')}</option>
            <option value="maintenance">{t('waForm.needMaintenance')}</option>
            <option value="other">{t('waForm.needOther')}</option>
          </select>
        </div>

        <div>
          <label for="wa-message" class="mb-1 block text-xs font-medium text-muted-foreground">{t('waForm.message')}</label>
          <textarea
            id="wa-message"
            rows="3"
            maxlength="500"
            placeholder={t('waForm.messagePlaceholder')}
            class="w-full glass-input rounded-xl px-4 py-2.5 text-sm text-foreground placeholder:text-muted-foreground outline-none resize-none"
          ></textarea>
        </div>
        <div>
          <p id="wa-preview-label" class="mb-1 block text-xs font-medium text-muted-foreground">{t('waForm.previewLabel')}</p>
          <div class="flex justify-end" aria-hidden="true">
            <div class="rounded-2xl rounded-tr-md bg-green-600/15 border border-green-600/25 px-4 py-3 max-w-[90%]">
              <p id="wa-preview" class="text-sm text-foreground leading-relaxed whitespace-pre-line"></p>
            </div>
          </div>
        </div>
      </form>

      <div class="p-3 border-t border-border bg-card/80 backdrop-blur-xl">
        <button
          type="button"
          id="wa-submit"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-green-600 px-4 py-3 text-sm font-semibold text-white transition hover:bg-green-600/90 active:scale-[0.98] cursor-interactive disabled:opacity-50"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true"><path d="M12.04 2a9.9 9.9 0 0 0-8.51 14.94L2 22l5.2-1.5A9.9 9.9 0 1 0 12.04 2Zm5.8 14.04c-.24.68-1.4 1.3-1.96 1.35-.5.05-1.13.07-3.23-.9-2.7-1.24-4.4-4.02-4.54-4.21-.13-.19-1.07-1.47-1.07-2.8 0-1.34.7-2 .95-2.27.24-.27.52-.34.7-.34h.5c.16 0 .38-.06.59.45.24.57.81 1.99.88 2.13.07.14.12.31.02.5-.09.19-.14.31-.28.48-.14.17-.3.38-.42.5-.14.14-.29.3-.13.58.17.28.74 1.23 1.6 1.99 1.1.99 2.03 1.3 2.32 1.44.29.14.46.12.63-.07.17-.2.72-.85.91-1.14.19-.29.38-.24.64-.14.26.09 1.66.78 1.94.93.28.14.47.21.54.33.07.12.07.7-.17 1.38Z"/></svg>

        <p class="mt-2 text-[0.6rem] text-center text-muted-foreground/70">
          {t('waForm.privacyNote')}
        </p>
      </div>
    </div>
  </div>
</div>

<style>
  @media (prefers-reduced-motion: reduce) {
    #consult-dialog *, #consult-dialog *::before, #consult-dialog *::after {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

<script>
import { buildWaConsultMessage, waConsultUrl } from '../lib/wa-consult'

let _dialogInited = false
;(window as any).consultDialog = {
  open: () => {
    if (!_dialogInited) {
      _dialogInited = true
      _doInitDialog()
    }
    ;(window as any).consultDialog.open()
  },
  close: () => {}
}

function _doInitDialog() {
(function() {
  const dialog = document.getElementById('consult-dialog')
  const backdrop = document.getElementById('consult-backdrop')
  const panel = document.getElementById('consult-panel')
  const closeBtn = document.getElementById('consult-close')
  const formEl = document.getElementById('wa-form') as HTMLFormElement | null
  const nameEl = document.getElementById('wa-name') as HTMLInputElement | null
  const needEl = document.getElementById('wa-need') as HTMLSelectElement | null
  const messageEl = document.getElementById('wa-message') as HTMLTextAreaElement | null
  const previewEl = document.getElementById('wa-preview')
  const submitBtn = document.getElementById('wa-submit')

  if (!dialog || !panel || !formEl || !nameEl || !needEl || !messageEl || !previewEl || !submitBtn) return

  const dialogEl = dialog
  const panelEl = panel
  let isOpen = false
  let previousFocus: HTMLElement | null = null

  function open() {
    if (isOpen) return
    isOpen = true
    previousFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null
    dialogEl.classList.remove('hidden')
    requestAnimationFrame(() => {
      panelEl.classList.remove('translate-y-full', 'sm:translate-y-8', 'opacity-0')
      panelEl.classList.add('translate-y-0', 'opacity-100')
    })
    nameEl!.focus()
    document.body.style.overflow = 'hidden'
  }

  function close() {
    isOpen = false
    panelEl.classList.remove('translate-y-0', 'opacity-100')
    panelEl.classList.add('translate-y-full', 'sm:translate-y-8', 'opacity-0')
    document.body.style.overflow = ''
    previousFocus?.focus()
    setTimeout(() => {
      if (!isOpen) dialogEl.classList.add('hidden')
    }, 300)
  }

  function updatePreview() {
    previewEl!.textContent = buildWaConsultMessage({
      name: nameEl!.value || '...',
      need: (needEl!.value as 'website' | 'mobile' | 'maintenance' | 'other'),
      message: messageEl!.value,
      source: window.location.host + window.location.pathname,
    })
  }

  formEl.addEventListener('input', updatePreview)
  updatePreview()

  function trackEvent(eventName: string, params?: Record<string, unknown>) {
    if (typeof (window as any).gtag === 'function') {
      (window as any).gtag('event', eventName, params || {})
    }
  }

  submitBtn.addEventListener('click', () => {
    if (!formEl.reportValidity()) return
    const url = waConsultUrl({
      name: nameEl!.value.trim(),
      need: (needEl!.value as 'website' | 'mobile' | 'maintenance' | 'other'),
      message: messageEl!.value.trim(),
      source: window.location.host + window.location.pathname,
    })
    trackEvent('whatsapp_click', { source: window.location.pathname })
    window.open(url, '_blank', 'noopener')
    close()
  })

  backdrop?.addEventListener('click', close)
  closeBtn?.addEventListener('click', close)

  document.addEventListener('keydown', (e) => {
    if (!isOpen) return
    if (e.key === 'Escape') close()
    if (e.key === 'Tab') {
      const controls = Array.from(panelEl.querySelectorAll<HTMLElement>('button:not([disabled]), a[href], input:not([disabled]), select:not([disabled]), textarea:not([disabled])')).filter(el => el.getClientRects().length)
      const first = controls[0], last = controls[controls.length - 1]
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last?.focus() }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first?.focus() }
    }
  })

  document.querySelectorAll('[data-consult-open]').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault()
      open()
    })
  })

  ;(window as any).consultDialog = { open, close }
})()
}

// GA4: lacak tombol konsultasi, link WhatsApp, dan tombol order di luar dialog.
function trackEvent(eventName: string, params?: Record<string, unknown>) {
  if (typeof window !== 'undefined' && typeof (window as any).gtag === 'function') {
    (window as any).gtag('event', eventName, params || {})
  }
}

document.querySelectorAll('[data-track="consultation"]').forEach(function(btn) {
  btn.addEventListener('click', function() { trackEvent('consultation_click', { source: 'button' }) })
})

document.querySelectorAll('a[data-track="whatsapp"]').forEach(function(link) {
  link.addEventListener('click', function() { trackEvent('whatsapp_click', { source: window.location.pathname }) })
})

document.querySelectorAll('a[data-track="order"], button[data-track="order"]').forEach(function(el) {
  el.addEventListener('click', function() { trackEvent('order_click', { source: window.location.pathname }) })
})
</script>
